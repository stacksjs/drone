<script client>
import type { MissionWorkspaceProfile, MissionWorkspaceRecording } from '../functions/drone/vehicles/workspace'
import { getMissionWorkspaceDefinition, missionWorkspaceProfiles, missionWorkspacePlot, runMissionWorkspace } from '../functions/drone/vehicles/workspace'
const profile = state<MissionWorkspaceProfile>('quadcopter')
const scenario = state('nominal')
const phase = state('front')
const electrical = state(false)
const result = state<MissionWorkspaceRecording | null>(null)
const offset = state(600)
const busy = state(false)
const error = state('')
const definition = derived(() => {
  const base = getMissionWorkspaceDefinition(profile(), 'nominal')
  const selected = base.scenarios.includes(scenario()) ? scenario() : 'nominal'
  if (profile() !== 'vtol') return getMissionWorkspaceDefinition(profile(), selected)
  const initial = getMissionWorkspaceDefinition('vtol', selected, { electrical: electrical() })
  return 'vtol' in initial && initial.vtol?.phase ? getMissionWorkspaceDefinition('vtol', selected, { phase: phase(), electrical: electrical() }) : initial
})
const vtolDefinition = derived(() => { const d = definition(); return 'vtol' in d ? d.vtol ?? null : null })
const recording = derived(() => {
  const r = result(), d = definition()
  const options = r && 'vtol' in r.definition ? r.definition.vtol : null
  return r && r.definition.profile === d.profile && r.definition.scenario === d.scenario && (options?.phase ?? null) === (vtolDefinition()?.phase ?? null) && (options?.electrical ?? false) === (vtolDefinition()?.electrical ?? false) ? r : null
})
const vtolResult = derived(() => { const r = recording(); return r && 'vtol' in r ? r.vtol ?? null : null })
const validTime = derived(() => !recording() || Number.isFinite(offset()) && Number.isInteger(offset()) && offset() >= recording()!.minimumTimeMs && offset() <= recording()!.maximumTimeMs && (offset() - recording()!.minimumTimeMs) % 20 === 0)
const playbackTime = derived(() => validTime() ? offset() : recording()?.minimumTimeMs || 600)
const rows = derived(() => recording()?.rows.filter(row => row.atMs <= playbackTime()) ?? [])
const current = derived(() => rows().at(-1) ?? null)
const modeObservation = derived(() => rows().findLast(row => row.vtol?.observation)?.vtol?.observation ?? null)
const modeEvents = derived(() => rows().filter((row, index, all) => {
  const current = row.vtol?.observation, previous = all[index - 1]?.vtol?.observation
  return current && (!previous || current.eventId !== previous.eventId || current.phase !== previous.phase || current.outcome !== previous.outcome)
}).map(row => ({ atMs: row.atMs, observation: row.vtol!.observation! })))
const operatorActions = derived(() => rows().filter(row => row.vtol?.action && row.vtol.action !== 'start'))
const events = derived(() => recording()?.transitions.filter(row => row.atMs <= playbackTime()) ?? [])
const requests = derived(() => recording()?.payloads.filter(row => row.issuedAtMs <= playbackTime()) ?? [])
const acknowledgements = derived(() => rows().filter(row => row.payloadAck).map(row => row.payloadAck!))
const inspectionFrames = derived(() => recording()?.inspection?.frames.filter(frame => acknowledgements().some(ack => ack.eventId === frame.eventId && ack.outcome === 'confirmed' && ack.correlated)).map(frame => ({ ...frame, pixels: frame.camera.pixels.map((value, index) => ({ value, index })) })) ?? [])
const plot = derived(() => missionWorkspacePlot(definition(), rows()))
const computation = useTimeout(() => {
  try {
    const completed = runMissionWorkspace(profile(), definition().scenario, vtolDefinition() ? { electrical: electrical(), ...(vtolDefinition()?.phase ? { phase: phase() } : {}) } : {})
    result.set(completed)
    // Mount the playback controls and their dynamic bounds before assigning the value.
    void nextTick(() => { if (result() === completed) offset.set(completed.maximumTimeMs) })
  }
  catch (failure) { error.set(failure instanceof Error ? failure.message : 'Mission simulation failed') }
  finally { busy.set(false) }
}, 32)
computation.stop()
onDestroy(() => computation.stop())
effect(() => {
  const selectedProfile = profile(), selectedScenario = scenario()
  phase(); electrical()
  computation.stop(); busy.set(false); result.set(null); error.set(''); offset.set(600)
  if (!getMissionWorkspaceDefinition(selectedProfile, 'nominal').scenarios.includes(selectedScenario)) scenario.set('nominal')
})
function execute() { error.set(''); result.set(null); offset.set(600); busy.set(true); computation.start() }
function reset() { computation.stop(); result.set(null); error.set(''); offset.set(600); busy.set(false) }
function vectorLabel(value: number[] | null | undefined) { return value ? value.map(n => n.toFixed(2)).join(', ') : 'released' }
</script>
<template>
  <section aria-labelledby="mission-title" :aria-busy="busy()">
    <h1 id="mission-title" class="font-semibold text-3xl tracking-tight">Owned mission workspace</h1>
    <p class="mt-3 max-w-3xl leading-relaxed text-neutral-400">Choose a vehicle, record its modeled mission and inspect the same decision timeline. Recorded vehicle positions come from the owned estimator.</p>
    <p class="mt-3 text-emerald-200 text-sm">Simulation only. Physical outputs remain inhibited.</p>
    <div class="flex flex-wrap gap-4 items-end mt-8">
      <div><label for="mission-profile" class="block mb-2 text-sm">Vehicle profile</label><select id="mission-profile" x-model="profile" class="px-3 py-3 max-w-full text-neutral-100 bg-neutral-900 border border-neutral-600 rounded focus-visible:outline-emerald-200"><option :for="name in missionWorkspaceProfiles" :value="name">{{ name }}</option></select></div>
      <div><label for="mission-scenario" class="block mb-2 text-sm">Operator scenario</label><select id="mission-scenario" x-model="scenario" class="px-3 py-3 max-w-full text-neutral-100 bg-neutral-900 border border-neutral-600 rounded focus-visible:outline-emerald-200"><option :for="name in definition().scenarios" :value="name">{{ name }}</option></select></div>
      <div :if="vtolDefinition()?.phases.length"><label for="mission-vtol-phase" class="block mb-2 text-sm">Fault injection phase</label><select id="mission-vtol-phase" x-model="phase" class="px-3 py-3 max-w-full text-neutral-100 bg-neutral-900 border border-neutral-600 rounded focus-visible:outline-emerald-200"><option :for="name in vtolDefinition()?.phases || []" :value="name">{{ name }}</option></select></div>
      <label :if="profile() === 'vtol'" for="mission-vtol-electrical" class="flex gap-3 items-center py-3 text-sm"><input id="mission-vtol-electrical" type="checkbox" x-model="electrical" class="accent-emerald-200">Modeled electrical load</label>
      <button type="button" @click="execute()" :disabled="busy()" class="px-4 py-3 font-medium text-neutral-950 whitespace-nowrap bg-emerald-200 rounded focus-visible:outline-emerald-200 focus-visible:outline-offset-4 disabled:opacity-60">{{ busy() ? 'Recording…' : 'Run scenario' }}</button>
      <button type="button" @click="reset()" class="px-4 py-3 text-sm whitespace-nowrap border border-neutral-600 rounded focus-visible:outline-emerald-200 focus-visible:outline-offset-4">Clear recording</button>
    </div>
    <p :if="busy()" role="status" class="mt-5 text-emerald-200 text-sm">Computing the bounded physics recording. Controls remain simulation-only.</p>
    <p :if="error()" role="alert" class="mt-5 p-4 text-red-200 border border-red-400 rounded">{{ error() }}</p>
    <div class="grid gap-8 lg:grid-cols-[1fr_1.5fr] mt-9">
      <aside class="min-w-0">
        <h2 class="font-semibold text-lg">{{ definition().name }}</h2>
        <p class="mt-2 break-words font-mono text-neutral-400 text-xs">{{ definition().planId }} / mission {{ definition().version }}</p>
        <p class="mt-2 font-mono text-neutral-400 text-xs">LOCAL_NED / declared origin 0, 0, 100 / WGS84 anchor</p>
        <p :if="profile() === 'subsea'" class="mt-2 text-neutral-400 text-xs">Depth is positive down from the declared local water surface. Bottom-locked DVL supplies local dead reckoning.</p>
        <dl class="grid gap-5 grid-cols-2 mt-5 text-sm">
          <div><dt class="text-neutral-400">Fence radius</dt><dd class="mt-1">{{ definition().fence.radiusM }} m</dd></div>
          <div><dt class="text-neutral-400">Down bounds</dt><dd class="mt-1">{{ definition().fence.minDownM }} to {{ definition().fence.maxDownM }} m</dd></div>
          <div><dt class="text-neutral-400">Worst case time</dt><dd class="mt-1">{{ definition().budget.worstCaseMs / 1000 }} s</dd></div>
          <div><dt class="text-neutral-400">Energy reserve checked</dt><dd class="mt-1">{{ definition().budget.requiredWh.toFixed(2) }} / {{ definition().budget.usableWh.toFixed(2) }} Wh usable</dd></div>
        </dl>
        <h3 class="mt-7 font-semibold text-sm">Tasks and graph edges</h3>
        <div class="overflow-x-auto mt-3 max-h-96"><table class="w-full text-left text-xs"><thead class="text-neutral-400"><tr><th scope="col" class="pr-3 py-3">Task</th><th scope="col" class="py-3">Goal / next</th></tr></thead><tbody><tr :for="task in definition().tasks" class="border-b border-neutral-800"><td class="pr-3 py-3 align-top"><span class="font-mono">{{ task.id }}</span><span class="block mt-1 text-neutral-400">{{ task.kind }}</span></td><td class="py-3 break-words"><span :if="task.targetM" class="font-mono">N/E/D {{ vectorLabel(task.targetM) }} m</span><span :if="task.operation" class="block font-mono text-emerald-200">{{ task.operation }} / {{ task.containerId || 'no container' }}</span><span :if="task.mode" class="block font-mono text-emerald-200">Requested mode: {{ task.mode }}</span><span :if="task.headingRad !== undefined && task.headingRad !== null" class="block font-mono text-neutral-400">Requested heading: {{ task.headingRad?.toFixed(3) }} rad from north</span><span :if="task.failureEdge" class="block mt-1 text-amber-200">Counted failure route: {{ task.failureEdge }}</span><span class="block mt-1 text-neutral-400">Next: {{ task.edges.join(' / ') || 'end' }}</span></td></tr></tbody></table></div>
        <p class="mt-4 leading-relaxed text-neutral-400 text-xs">{{ definition().assumptions }}</p>
      </aside>
      <div class="min-w-0">
        <h2 class="font-semibold text-lg">Estimated route, north up</h2>
        <svg width="360" height="360" viewBox="0 0 360 360" role="img" aria-label="North-up estimated route with planned task goals, east increasing to the right" class="mt-4 max-h-96 w-full bg-neutral-900 border border-neutral-700 rounded">
          <text x="180" y="18" text-anchor="middle" fill="#a3a3a3" font-size="11">North</text><text x="340" y="184" text-anchor="middle" fill="#a3a3a3" font-size="11">East</text>
          <line x1="40" y1="180" x2="320" y2="180" stroke="#404040" stroke-width="1" /><line x1="180" y1="40" x2="180" y2="320" stroke="#404040" stroke-width="1" />
          <polyline :points="plot().estimated" fill="none" stroke="#a7f3d0" stroke-width="2" />
          <g :for="goal in plot().tasks"><rect :x="goal.x - 3" :y="goal.y - 3" width="6" height="6" fill="none" stroke="#a3a3a3" /><title>{{ goal.id }}</title></g>
          <circle :if="plot().current" :cx="plot().current?.x" :cy="plot().current?.y" r="4" fill="#a7f3d0" />
        </svg>
        <p class="mt-2 text-neutral-400 text-xs">{{ plot().spanM.toFixed(1) }} m square extent. Squares mark task goals; emerald shows the recorded estimate. This is a local route, not a geographic map.</p>
        <p :if="!recording() && !busy() && !error()" class="mt-7 py-5 leading-relaxed text-neutral-400 border-neutral-700 border-t">No recording for this selection. Run a scenario to inspect decisions, payload outcomes and the independent modeled board.</p>
        <div :if="recording() && current()" class="mt-7">
          <dl class="grid gap-5 grid-cols-2 text-sm">
            <div><dt class="text-neutral-400">Run outcome</dt><dd class="mt-2 font-mono text-emerald-200 text-lg" data-mission-outcome>{{ recording()?.status }}</dd></div>
            <div><dt class="text-neutral-400">Recorded mission state</dt><dd class="mt-2 font-mono text-lg" data-mission-state>{{ current()?.state }}</dd></div>
            <div><dt class="text-neutral-400">Current task</dt><dd class="mt-2 break-all font-mono" data-mission-task>{{ current()?.taskId }}</dd></div>
            <div><dt class="text-neutral-400">Decision</dt><dd class="mt-2 break-words font-mono text-xs">{{ current()?.reason }}</dd></div>
          </dl>
          <p :if="recording()?.snapshotsStale" role="status" class="mt-5 p-3 text-amber-200 border border-amber-400 rounded">Host lost. The mission and authority snapshots are stale. The independent modeled board continued and expired its output lease.</p>
          <p class="mt-4 text-neutral-400 text-xs">Final modeled board: {{ recording()?.boardNeutral ? 'neutral output' : 'active output' }}. Board fault: {{ recording()?.boardFault || 'none' }}. {{ recording()?.snapshotsStale ? 'Last host authority snapshot' : 'Final authority snapshot' }}: {{ recording()?.authorityState }}.</p>
          <p :if="recording()?.fault" class="mt-2 break-words font-mono text-neutral-400 text-xs">Outcome reason: {{ recording()?.fault }}</p>
          <label for="mission-time" class="flex flex-wrap gap-3 justify-between mt-7 text-sm">Recorded fixture time <span class="font-mono">{{ offset() }} ms</span></label>
          <input id="mission-time" type="range" :min="recording()?.minimumTimeMs || 600" :max="recording()?.maximumTimeMs || 600" step="20" x-model.number="offset" class="mt-3 w-full accent-emerald-200">
          <div class="flex flex-wrap gap-3 items-end mt-3"><div><label for="mission-time-number" class="block mb-1 text-neutral-400 text-xs">Recorded time / ms</label><input id="mission-time-number" type="number" :min="recording()?.minimumTimeMs || 600" :max="recording()?.maximumTimeMs || 600" step="20" x-model.number="offset" class="px-3 py-2 w-36 bg-neutral-900 border border-neutral-600 rounded focus-visible:outline-emerald-200"></div><button type="button" @click="offset.set(recording()?.minimumTimeMs || 600)" class="px-3 py-2 text-sm border border-neutral-600 rounded focus-visible:outline-emerald-200">Beginning</button><button type="button" @click="offset.set(recording()?.maximumTimeMs || 600)" class="px-3 py-2 text-sm border border-neutral-600 rounded focus-visible:outline-emerald-200">End of recording</button></div>
          <p :if="!validTime()" role="alert" class="mt-3 text-amber-200 text-sm">Enter a recorded time from {{ recording()?.minimumTimeMs }} to {{ recording()?.maximumTimeMs }} ms in 20 ms steps. Showing the beginning until the time is valid.</p>
          <p class="mt-5 break-words font-mono text-neutral-400 text-xs">Estimated N/E/D: {{ vectorLabel(current()?.positionM) }} m</p><p class="mt-2 break-words font-mono text-neutral-400 text-xs">Estimated velocity N/E/D: {{ vectorLabel(current()?.velocityMps) }} m/s</p><p class="mt-2 break-words font-mono text-neutral-400 text-xs">Target N/E/D: {{ vectorLabel(current()?.targetM) }}</p>
          <section :if="profile() === 'vtol'" aria-labelledby="vtol-evidence-title" class="mt-7 pt-5 border-neutral-700 border-t">
            <h3 id="vtol-evidence-title" class="font-semibold text-sm">Recorded VTOL evidence</h3>
            <p class="mt-2 text-neutral-400 text-xs" data-vtol-demonstration>Named outcome check: {{ vtolResult()?.demonstrationMatched ? 'matched' : 'unmatched' }}. Final qualified landing contact: {{ vtolResult()?.landingContact ? 'observed' : 'not observed' }}.</p>
            <p class="mt-2 leading-relaxed text-neutral-400 text-xs">A matched case can be blocked, aborted or host-lost. These are recorded model observations, not physical flight qualification.</p>
            <div :if="vtolResult()?.windEvidence" class="mt-5" data-vtol-wind>
              <h4 class="font-semibold text-sm">Declared world wind</h4>
              <p class="mt-2 break-words font-mono text-neutral-400 text-xs">LOCAL_NED {{ vectorLabel(vtolResult()?.windEvidence?.windMps) }} m/s, from {{ vtolResult()?.windEvidence?.beginsAtMs }} ms.</p>
              <p class="mt-2 text-neutral-400 text-xs">World exposure check: {{ vtolResult()?.windEvidence?.worldMatched ? 'matched' : 'unmatched' }}. Expected result: {{ vtolResult()?.windEvidence?.expectedOutcome === 'completed-route' ? 'completed route' : 'back-transition envelope stop' }}.</p>
              <p class="mt-2 text-neutral-400 text-xs">The wind is a model input. It is not supplied to the controller or reported as a measured wind estimate.</p>
              <p :if="vtolResult()?.windEvidence?.backHeadingRad !== undefined" class="mt-2 text-neutral-400 text-xs" data-vtol-wind-heading>Back hover heading: {{ vtolResult()?.windEvidence?.backHeadingRad?.toFixed(3) }} rad from north. Plan heading check: {{ vtolResult()?.windEvidence?.backHeadingMatched ? 'matched' : 'unmatched' }}. This separately declared plan keeps the fixed north-facing limit cases unchanged.</p>
              <p :if="vtolResult()?.windEvidence?.expectedOutcome === 'envelope-stop'" class="mt-2 leading-relaxed text-amber-200 text-xs" data-vtol-wind-limit>This plan with a fixed north heading remains outside the supported route envelope. A matched stop does not certify hover, contact or a safe landing.</p>
            </div>
            <p :if="modeObservation()" class="mt-4 break-words font-mono text-sm" data-vtol-mode>{{ modeObservation()?.phase }} / {{ modeObservation()?.outcome }} / {{ modeObservation()?.taskId }}</p>
            <p :if="modeObservation()" class="mt-2 break-words font-mono text-neutral-400 text-xs">Last mode observation captured {{ modeObservation()?.capturedAtMs }} ms, sensor capture {{ modeObservation()?.measurementCapturedAtMs }} ms. Age at cursor: {{ playbackTime() - (modeObservation()?.capturedAtMs || 0) }} ms.</p>
            <p :if="!modeObservation()" class="mt-3 text-neutral-400 text-xs">No recorded mode observation at this time.</p>
            <p :if="current()?.vtol?.request" class="mt-3 break-all font-mono text-neutral-400 text-xs">Mode request {{ current()?.vtol?.request?.mode }} / {{ current()?.vtol?.request?.eventId }} / expires {{ current()?.vtol?.request?.expiresAtMs }} ms</p>
            <div :if="vtolDefinition()?.electrical" class="mt-5">
              <h4 class="font-semibold text-sm">Captured battery reading</h4>
              <dl :if="current()?.vtol?.battery" class="grid gap-4 grid-cols-2 mt-3 text-xs" data-vtol-battery>
                <div><dt class="text-neutral-400">Chemical energy used</dt><dd class="mt-1 font-mono">{{ current()?.vtol?.battery?.energyUsedWh.toFixed(3) }} Wh</dd></div>
                <div><dt class="text-neutral-400">Remaining lower bound</dt><dd class="mt-1 font-mono">{{ current()?.vtol?.battery?.remainingWhLowerBound.toFixed(3) }} Wh / {{ current()?.vtol?.battery?.remainingPercentLowerBound.toFixed(2) }}%</dd></div>
                <div><dt class="text-neutral-400">Source / load</dt><dd class="mt-1 font-mono">{{ current()?.vtol?.battery?.sourcePowerW.toFixed(2) }} / {{ current()?.vtol?.battery?.loadPowerW.toFixed(2) }} W</dd></div>
                <div><dt class="text-neutral-400">Terminal / current</dt><dd class="mt-1 font-mono">{{ current()?.vtol?.battery?.terminalV.toFixed(3) }} V / {{ current()?.vtol?.battery?.currentA.toFixed(3) }} A</dd></div>
              </dl>
              <p :if="current()?.vtol?.battery" class="mt-3 break-words font-mono text-neutral-400 text-xs">Capture {{ current()?.vtol?.battery?.capturedAtMs }} ms / observed {{ current()?.vtol?.battery?.observedAtMs }} ms / sequence {{ current()?.vtol?.battery?.sequence }} / cutoff {{ current()?.vtol?.battery?.cutoff ? 'latched' : 'clear' }}</p>
              <p :if="!current()?.vtol?.battery" class="mt-3 text-amber-200 text-xs" data-vtol-battery-missing>No qualified battery capture at this recorded time.</p>
              <p class="mt-3 leading-relaxed text-neutral-400 text-xs">Fictional 100 Wh pack. The remaining lower bound includes worst-case consumption since capture. Host loss freezes host readings. No measured cell or motor calibration.</p>
            </div>
            <p :if="!vtolDefinition()?.electrical" class="mt-4 text-neutral-400 text-xs">Electrical measurements are off. The mission still checks its declared planning power ceiling and reserve.</p>
            <div :for="row in operatorActions()" class="mt-3 break-words font-mono text-neutral-400 text-xs">Operator {{ row.vtol?.action }} at {{ row.atMs }} ms / {{ row.state }} / {{ row.taskId }}</div>
            <div class="overflow-x-auto mt-4"><table class="w-full text-left text-xs"><caption class="py-2 text-left text-neutral-400">Mode changes and request-bound acknowledgements</caption><thead class="text-neutral-400"><tr><th scope="col" class="pr-3 py-3">Time / ms</th><th scope="col" class="pr-3 py-3">Request task</th><th scope="col" class="py-3">Phase / outcome</th></tr></thead><tbody><tr :for="row in modeEvents()" class="border-b border-neutral-800" data-vtol-mode-event><td class="pr-3 py-3 font-mono">{{ row.atMs }}</td><td class="pr-3 py-3 break-words font-mono">{{ row.observation.taskId }}</td><td class="py-3 break-words font-mono">{{ row.observation.phase }} / {{ row.observation.outcome }}</td></tr></tbody></table></div>
          </section>
          <h3 class="mt-7 font-semibold text-sm">Payload events <span class="font-mono text-neutral-400" data-mission-payloads>{{ requests().length }}</span></h3>
          <p :if="!requests().length" class="mt-2 text-neutral-400 text-xs">No payload request at this time.</p>
          <div :for="payload in requests()" class="mt-3 py-3 border-neutral-800 border-t"><p class="break-words font-mono text-xs">{{ payload.operation }} / {{ payload.containerId || 'no container' }} / {{ payload.taskId }}</p><p class="mt-1 break-all text-neutral-400 text-xs">{{ payload.eventId }} / {{ payload.evidence }}</p></div>
          <div :for="ack in acknowledgements()" class="mt-3 py-3 border-neutral-800 border-t"><p class="break-words font-mono text-xs" :class="ack.outcome === 'confirmed' && ack.correlated ? 'text-emerald-200' : 'text-amber-200'">ACK {{ ack.operation }} / {{ ack.containerId || 'no container' }} / {{ ack.outcome }}</p><p class="mt-1 break-all text-neutral-400 text-xs">{{ ack.eventId }} / {{ ack.correlated ? 'correlated request' : 'uncorrelated acknowledgement' }}</p></div>
          <p :if="profile() === 'quadcopter' && requests().length" class="mt-3 text-neutral-400 text-xs">Version 1 camera events have no hardware acknowledgement and acquire no image.</p>
          <h3 class="mt-7 font-semibold text-sm">Recorded transitions</h3><div class="overflow-x-auto mt-3"><table class="w-full text-left text-xs"><thead class="text-neutral-400"><tr><th scope="col" class="pr-3 py-3">Time / ms</th><th scope="col" class="pr-3 py-3">Task</th><th scope="col" class="py-3">State / reason</th></tr></thead><tbody><tr :for="row in events()" class="border-b border-neutral-800"><td class="pr-3 py-3 font-mono">{{ row.atMs }}</td><td class="pr-3 py-3 font-mono">{{ row.taskId }}</td><td class="py-3 break-words font-mono">{{ row.state }} / {{ row.reason }}</td></tr></tbody></table></div>
        </div>
      </div>
    </div>
    <section :if="recording()?.survey" class="mt-9 pt-5 border-neutral-700 border-t" aria-labelledby="survey-summary-title"><h2 id="survey-summary-title" class="font-semibold text-lg">Modeled single-beam survey</h2><dl class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4 mt-4 text-sm"><div><dt class="text-neutral-400">Distinct soundings</dt><dd class="mt-1 font-mono">{{ recording()?.survey?.count }}</dd></div><div><dt class="text-neutral-400">Depth below declared datum</dt><dd class="mt-1 font-mono">{{ recording()?.survey?.minimumDepthM.toFixed(2) }} to {{ recording()?.survey?.maximumDepthM.toFixed(2) }} m</dd></div><div><dt class="text-neutral-400">Maximum vertical sigma</dt><dd class="mt-1 font-mono">{{ recording()?.survey?.maximumVerticalSigmaM.toFixed(3) }} m</dd></div><div><dt class="text-neutral-400">Maximum horizontal sigma</dt><dd class="mt-1 font-mono">{{ recording()?.survey?.maximumHorizontalSigmaM.toFixed(3) }} m</dd></div></dl><p class="mt-3 break-words font-mono text-neutral-400 text-xs">{{ recording()?.survey?.datum }}</p><p class="mt-2 leading-relaxed text-neutral-400 text-xs">{{ recording()?.survey?.assumptions }}</p></section>
    <section :if="recording()?.inspection" class="mt-9 pt-5 border-neutral-700 border-t" aria-labelledby="inspection-summary-title">
      <h2 id="inspection-summary-title" class="font-semibold text-lg">Modeled camera and sonar inspection</h2>
      <p class="mt-3 leading-relaxed text-neutral-400 text-sm">Synthetic 4 by 4 luminance and single-beam ranges, joined to the owned pressure/DVL capture pose. These records do not establish physical image acquisition or inspection coverage.</p>
      <p class="mt-3 font-mono text-neutral-400 text-xs">Run source counts, raw GNSS: {{ recording()?.navigationEvidence?.observedSensors.gnss }} / IMU observations: {{ recording()?.navigationEvidence?.observedSensors.imu }} / LOCAL_WATER_SURFACE</p>
      <p :if="!inspectionFrames().length" class="mt-4 text-neutral-400 text-sm">No acknowledged inspection capture at this recorded time.</p>
      <div :for="frame in inspectionFrames()" class="grid gap-5 sm:grid-cols-[8rem_1fr] mt-5 py-5 border-neutral-800 border-t">
        <svg width="128" height="128" viewBox="0 0 4 4" role="img" aria-label="Synthetic four by four monochrome camera capture" class="border border-neutral-600">
          <rect :for="pixel in frame.pixels" :x="pixel.index % 4" :y="Math.floor(pixel.index / 4)" width="1" height="1" :fill="'rgb(' + pixel.value + ',' + pixel.value + ',' + pixel.value + ')'" />
        </svg>
        <div class="min-w-0"><p class="break-all font-mono text-xs">{{ frame.eventId }}</p><p class="mt-2 font-mono text-neutral-400 text-xs">Captured {{ frame.capturedAtMs }} ms / reference {{ frame.reference }}</p><p class="mt-2 break-words font-mono text-neutral-400 text-xs">Estimated capture N/E/D: {{ vectorLabel(frame.positionM) }} m</p><p class="mt-2 font-mono text-neutral-400 text-xs">Forward range: {{ frame.sonar.rangeM.toFixed(3) }} m / bottom: {{ frame.sonar.bottomRangeM.toFixed(3) }} m</p><p class="mt-2 text-neutral-400 text-xs">PGM P5 / 4 by 4 pixels / {{ frame.camera.bytes.length }} bytes. Local alignment only, no global georeferencing.</p></div>
      </div>
    </section>
    <p class="mt-10 pt-5 leading-relaxed text-neutral-400 text-xs border-neutral-700 border-t">Neutral output does not prove stopping, braking or emergency landing. Vehicle models, recorded acknowledgements and survey corrections require separate hardware validation.</p>
  </section>
</template>
