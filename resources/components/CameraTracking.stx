<script client>
import type { CameraSnapshot } from '../functions/drone/camera/types'
import { cameraRequest } from '../functions/drone/camera/client'

const token = state('')
const current = state<CameraSnapshot | null>(null)
const connected = state(false)
const busy = state(false)
const error = state('')

let refreshing = false
let revision = 0
async function refresh() {
  if (busy() || refreshing) return
  refreshing = true
  const requestedRevision = revision
  try {
    const response = await cameraRequest(token())
    if (requestedRevision !== revision) return
    current.set(response); connected.set(true); error.set('')
  }
  catch (failure) {
    if (requestedRevision !== revision) return
    current.set(null); connected.set(false); error.set(failure instanceof Error ? failure.message : 'Camera connection failed')
  }
  finally { refreshing = false }
}
async function command(body: Record<string, unknown>) {
  if (busy()) return
  busy.set(true)
  revision++
  try { current.set(await cameraRequest(token(), body)); error.set('') }
  catch (failure) { error.set(failure instanceof Error ? failure.message : 'Camera command failed') }
  finally { busy.set(false) }
}
function select(candidateId: string) {
  const frame = current()
  if (frame) void command({ command: 'select', candidateId, sequence: frame.tracking.sequence, sessionId: frame.sessionId })
}
function disconnect() { revision++; connected.set(false); current.set(null); token.set(''); error.set('') }
onDestroy(() => { revision++ })
useInterval(() => { if (connected() && !busy()) void refresh() }, 250, { whileVisible: true })
</script>

<template>
  <section aria-labelledby="camera-title">
    <h1 id="camera-title" class="font-semibold text-3xl tracking-tight">Choose who the camera tracks.</h1>
    <p class="mt-3 max-w-2xl text-neutral-400">Select a person explicitly. Ambiguity, missing detections, and stale inference invalidate the lock. A lost lock requires a new selection.</p>
    <form :if="!connected()" @submit.prevent="refresh()" class="mt-8 space-y-3 max-w-lg">
      <label for="camera-token" class="block text-sm">Camera operator token</label>
      <input id="camera-token" x-model="token" type="password" autocomplete="off" minlength="32" maxlength="128" required class="px-3 py-3 w-full bg-neutral-900 border border-neutral-600 rounded focus-visible:outline-emerald-200">
      <button type="submit" :disabled="busy()" class="px-4 py-3 font-semibold text-neutral-950 bg-emerald-200 rounded disabled:opacity-40">Connect</button>
      <p class="text-neutral-400 text-sm">Use the token configured on your Pi. It stays in this tab's memory.</p>
    </form>
    <p :if="error()" class="mt-5 p-3 text-sm border border-neutral-600 rounded" role="alert">{{ error() }}</p>
    <div :if="connected() && current()" class="grid gap-8 lg:grid-cols-[1.6fr_1fr] mt-8">
      <div class="min-w-0">
        <div class="overflow-hidden relative border border-neutral-700 rounded-lg camera-view" aria-label="Camera target selection">
          <img :if="current()?.image" :src="current()?.image" width="640" height="480" alt="Live Pi AI Camera preview" class="absolute inset-0 object-contain h-full w-full">
          <p :if="!current()?.image" class="absolute left-4 right-4 top-4 text-neutral-400 text-sm">{{ current()?.source === 'replay' ? 'REPLAY / schematic detections, no camera image' : 'Waiting for fresh camera inference and preview' }}</p>
          <button :for="candidate in current()?.tracking.candidates || []" type="button" @click="select(candidate.id)" :disabled="busy()" :style="`left:${candidate.box.x * 100}%;top:${candidate.box.y * 100}%;width:${candidate.box.width * 100}%;height:${candidate.box.height * 100}%`" :aria-label="`Select person candidate ${candidate.id}`" class="absolute text-left bg-transparent border-2 border-emerald-200 focus-visible:outline-white">
            <span class="absolute bottom-0 left-0 right-0 p-1 font-mono text-emerald-200 text-xs bg-neutral-950">Select person / {{ Math.round(candidate.confidence * 100) }}%</span>
          </button>
        </div>
        <p class="mt-3 text-neutral-400 text-xs">{{ current()?.source === 'imx500' ? 'IMX500 / SSD MobileNet / 640 x 480' : 'Camera replay / deterministic test source' }}</p>
      </div>
      <div>
        <div role="status" aria-live="polite" class="p-4 border border-neutral-700 rounded">
          <h2 class="text-neutral-400 text-xs">Visual lock</h2>
          <p class="mt-2 font-mono text-emerald-200" data-tracking-state>{{ current()?.tracking.state.toUpperCase() }}</p>
          <p class="mt-2 text-sm">{{ current()?.tracking.reason }}</p><p :if="current()?.tracking.selected" class="mt-2 break-all font-mono text-neutral-400 text-xs">Lock {{ current()?.tracking.selected?.id }}</p>
          <p :if="current()?.tracking.confirmed" class="mt-2 text-sm">Continuity confirmed across frames.</p>
        </div>
        <dl class="grid gap-4 grid-cols-2 mt-5 text-sm"><div><dt class="text-neutral-400">Source</dt><dd class="mt-1 font-mono">{{ current()?.source }}</dd></div><div><dt class="text-neutral-400">Status</dt><dd class="mt-1 font-mono">{{ current()?.status }}</dd></div></dl>
        <p :if="current()?.error" role="alert" class="mt-4 text-sm">{{ current()?.error }}</p>
        <div class="grid gap-3 mt-6">
          <button type="button" @click="command({ command: 'start', source: 'replay' })" :disabled="busy() || current()?.source !== 'stopped'" class="px-4 py-3 font-semibold text-neutral-950 bg-emerald-200 rounded disabled:opacity-40">Start replay</button>
          <button type="button" @click="command({ command: 'start', source: 'imx500' })" :disabled="busy() || current()?.source !== 'stopped'" class="px-4 py-3 border border-neutral-600 rounded disabled:opacity-40">Start Pi AI Camera</button>
          <button type="button" @click="command({ command: 'clear' })" :disabled="busy() || !current()?.tracking.selected" class="px-4 py-3 border border-neutral-600 rounded disabled:opacity-40">Clear selection</button>
          <button type="button" @click="command({ command: 'stop' })" :disabled="busy() || current()?.source === 'stopped'" class="px-4 py-3 border border-neutral-600 rounded disabled:opacity-40">Stop source</button>
        </div>
        <div :if="current()?.source === 'replay'" class="mt-6 pt-5 border-neutral-700 border-t"><h2 class="mb-3 text-sm">Test loss handling</h2><div class="flex flex-wrap gap-2"><button type="button" @click="command({ command: 'inject', fault: 'loss' })" :disabled="busy()" class="px-3 py-2 text-sm border border-neutral-600 rounded">Lose detections</button><button type="button" @click="command({ command: 'inject', fault: 'ambiguity' })" :disabled="busy()" class="px-3 py-2 text-sm border border-neutral-600 rounded">Ambiguous people</button><button type="button" @click="command({ command: 'inject', fault: 'none' })" :disabled="busy()" class="px-3 py-2 text-sm border border-neutral-600 rounded">Restore detections</button></div></div>
        <button type="button" @click="disconnect()" class="mt-5 text-neutral-400 text-sm underline underline-offset-4">Disconnect this tab</button>
        <p class="mt-5 leading-relaxed text-neutral-400 text-xs">Visual association is not biometric identity. A 2D box supplies no metric distance or flight position. This screen never arms or commands a vehicle.</p>
      </div>
    </div>
  </section>
</template>
<style>
.camera-view { aspect-ratio: 4 / 3; background: #1b1f1d; }
button:focus-visible { outline: 2px solid #a7f3d0; outline-offset: 4px; }
</style>
