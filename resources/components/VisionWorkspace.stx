<script client>
import type { VisionScenario } from '../functions/drone/vision/simulation'
import { simulateVision, visionScenarios } from '../functions/drone/vision/simulation'
type Recording = ReturnType<typeof simulateVision>
const scenario = state<VisionScenario>('follow')
const result = state<Recording | null>(null)
const busy = state(false)
const error = state('')
const rowIndex = state(0)
const recording = derived(() => result()?.scenario === scenario() ? result() : null)
const validIndex = derived(() => Number.isInteger(rowIndex()) && rowIndex() >= 0 && rowIndex() < (recording()?.path.length ?? 1))
const rows = derived(() => recording()?.path.slice(0, (validIndex() ? rowIndex() : 0) + 1) ?? [])
const current = derived(() => rows().at(-1) ?? null)
const transitions = derived(() => rows().filter((row, index, all) => index === 0 || row.state !== all[index - 1]?.state || row.reason !== all[index - 1]?.reason).slice(-8))
function vector(value: number[] | null | undefined) { return value ? value.map(n => n.toFixed(2)).join(', ') : 'unavailable' }
function points(kind: 'positionM' | 'targetTruthM' | 'fusedM') {
  return rows().flatMap(row => {
    const point = row[kind]
    return point ? [`${40 + (point[1]! + 6) / 12 * 280},${320 - (point[0]! + 1) / 12 * 280}`] : []
  }).join(' ')
}
const computation = useTimeout(() => {
  try {
    const completed = simulateVision({ scenario: scenario() })
    result.set(completed)
    void nextTick(() => { if (result() === completed) rowIndex.set(completed.path.length - 1) })
  }
  catch (failure) { error.set(failure instanceof Error ? failure.message : 'Vision simulation failed') }
  finally { busy.set(false) }
}, 32)
computation.stop()
onDestroy(() => computation.stop())
effect(() => { scenario(); computation.stop(); result.set(null); busy.set(false); error.set(''); rowIndex.set(0) })
function execute() { result.set(null); error.set(''); rowIndex.set(0); busy.set(true); computation.start() }
function clear() { computation.stop(); result.set(null); busy.set(false); error.set(''); rowIndex.set(0) }
</script>
<template>
  <section aria-labelledby="vision-title" :aria-busy="busy()">
    <h1 id="vision-title" class="font-semibold text-3xl tracking-tight">Calibrated target fusion</h1>
    <p class="mt-3 max-w-3xl leading-relaxed text-neutral-400">Inspect an explicit visual lock paired with one GNSS target. Registered depth and capture-time pose turn the selected image point into a local measurement.</p>
    <p class="mt-3 text-emerald-200 text-sm">Owned physics simulation. Synthetic camera and depth. Physical outputs remain inhibited.</p>
    <div class="flex flex-wrap gap-4 items-end mt-8">
      <div><label for="vision-scenario" class="block mb-2 text-sm">Operator scenario</label><select id="vision-scenario" x-model="scenario" class="px-3 py-3 max-w-full text-neutral-100 bg-neutral-900 border border-neutral-600 rounded focus-visible:outline-emerald-200"><option :for="name in visionScenarios" :value="name">{{ name }}</option></select></div>
      <button type="button" @click="execute()" :disabled="busy()" class="px-4 py-3 font-medium text-neutral-950 bg-emerald-200 rounded focus-visible:outline-emerald-200 focus-visible:outline-offset-4 disabled:opacity-60">{{ busy() ? 'Recording…' : 'Run pairing scenario' }}</button>
      <button type="button" @click="clear()" class="px-4 py-3 text-sm border border-neutral-600 rounded focus-visible:outline-emerald-200 focus-visible:outline-offset-4">Clear recording</button>
    </div>
    <p :if="busy()" role="status" class="mt-5 text-emerald-200 text-sm">Running the owned sensor, estimator, authority and control loops.</p>
    <p :if="error()" role="alert" class="mt-5 p-4 text-red-200 border border-red-400 rounded">{{ error() }}</p>
    <p :if="!recording() && !busy() && !error()" class="mt-7 py-5 text-neutral-400 border-neutral-700 border-t">No recording yet. The scenario script explicitly selects and pairs a target after confirming the visual lock.</p>
    <div :if="recording()" class="grid gap-8 lg:grid-cols-[1fr_1.5fr] mt-9">
      <aside class="min-w-0">
        <h2 class="font-semibold text-lg">Calibration and pairing</h2>
        <p class="mt-3 break-all font-mono text-neutral-400 text-xs">{{ recording()?.calibration.calibrationId }}</p>
        <dl class="grid gap-5 grid-cols-2 mt-5 text-sm">
          <div><dt class="text-neutral-400">Held-out samples</dt><dd class="mt-1">{{ recording()?.calibration.samples }}</dd></div>
          <div><dt class="text-neutral-400">Maximum residual</dt><dd class="mt-1">{{ recording()?.calibration.maxErrorM.toFixed(4) }} m</dd></div>
          <div><dt class="text-neutral-400">Depth interval</dt><dd class="mt-1">{{ recording()?.calibration.minDepthM }} to {{ recording()?.calibration.maxDepthM }} m</dd></div>
          <div><dt class="text-neutral-400">Run outcome</dt><dd class="mt-1 font-mono text-emerald-200" data-vision-outcome>{{ recording()?.status }}</dd></div>
        </dl>
        <p class="mt-5 break-all font-mono text-xs">Selected target: {{ recording()?.fusion.pairing?.targetId || 'not paired' }}</p>
        <p class="mt-2 break-all font-mono text-neutral-400 text-xs">Target session: {{ recording()?.fusion.pairing?.targetSessionId || 'unavailable' }}</p>
        <p class="mt-2 break-all font-mono text-neutral-400 text-xs">Camera session: {{ recording()?.fusion.pairing?.cameraSessionId || 'unavailable' }}</p>
        <p class="mt-5 leading-relaxed text-neutral-400 text-sm">The fixture assumes initial north alignment and bounds heading drift. The estimator itself does not observe absolute heading.</p>
        <p class="mt-3 leading-relaxed text-neutral-400 text-sm">The Pi AI Camera view stays in image coordinates until a measured lens/mount calibration, synchronized depth, and surveyed pose are available.</p>
        <a href="https://github.com/stacksjs/drone/blob/main/docs/vision.md" class="inline-block mt-5 text-emerald-200 text-sm underline underline-offset-4">Measurement contract and remaining evidence</a>
      </aside>
      <div class="min-w-0">
        <h2 class="font-semibold text-lg">Recorded local positions</h2>
        <svg width="360" height="360" viewBox="0 0 360 360" role="img" aria-label="Local north-up plot of estimated vehicle, modeled target and fused target positions" class="mt-4 max-h-96 w-full bg-neutral-900 border border-neutral-700 rounded">
          <text x="180" y="18" text-anchor="middle" fill="#a3a3a3" font-size="11">North</text><text x="340" y="184" text-anchor="middle" fill="#a3a3a3" font-size="11">East</text>
          <line x1="40" y1="296.67" x2="320" y2="296.67" stroke="#404040" stroke-width="1" /><line x1="180" y1="40" x2="180" y2="320" stroke="#404040" stroke-width="1" />
          <polyline :points="points('targetTruthM')" fill="none" stroke="#a3a3a3" stroke-width="2" stroke-dasharray="4 4" />
          <polyline :points="points('fusedM')" fill="none" stroke="#fde68a" stroke-width="2" />
          <polyline :points="points('positionM')" fill="none" stroke="#a7f3d0" stroke-width="2" />
        </svg>
        <p class="mt-2 text-neutral-400 text-xs">12 m square extent, north up. Emerald: vehicle estimate. Amber: fused target. Dashed grey: independently modeled target truth.</p>
        <label for="vision-row" class="flex flex-wrap gap-3 justify-between mt-7 text-sm">Recorded fixture time <span class="font-mono">{{ current()?.nowMs }} ms</span></label>
        <input id="vision-row" type="range" min="0" :max="(recording()?.path.length || 1) - 1" step="1" x-model.number="rowIndex" class="mt-3 w-full accent-emerald-200">
        <div class="flex flex-wrap gap-3 mt-3"><button type="button" @click="rowIndex.set(0)" class="px-3 py-2 text-sm border border-neutral-600 rounded focus-visible:outline-emerald-200">Beginning</button><button type="button" @click="rowIndex.set((recording()?.path.length || 1) - 1)" class="px-3 py-2 text-sm border border-neutral-600 rounded focus-visible:outline-emerald-200">End of recording</button></div>
        <dl class="grid gap-5 grid-cols-2 mt-7 text-sm">
          <div><dt class="text-neutral-400">Recorded control state</dt><dd class="mt-2 font-mono text-lg" data-vision-state>{{ current()?.state }}</dd></div>
          <div><dt class="text-neutral-400">Isotropic sigma bound</dt><dd class="mt-2 font-mono">{{ current()?.sigmaM?.toFixed(3) || 'unavailable' }} m</dd></div>
        </dl>
        <p class="mt-4 break-words font-mono text-neutral-400 text-xs" data-vision-reason>{{ current()?.reason }}</p>
        <p class="mt-3 break-all font-mono text-neutral-400 text-xs">Visual lock: {{ current()?.selectedLockId || 'none' }}</p>
        <p class="mt-3 break-words font-mono text-neutral-400 text-xs">Metric visual N/E/D: {{ vector(current()?.visionM) }} m</p>
        <p class="mt-2 break-words font-mono text-neutral-400 text-xs">Fused N/E/D: {{ vector(current()?.fusedM) }} m</p>
        <p class="mt-2 break-words font-mono text-neutral-400 text-xs">Position command N/E/D: {{ vector(current()?.targetM) }} m</p>
        <p class="mt-4 text-neutral-400 text-xs">The operator script releases control at the end. A fault releases modeled thrust and latches loss; this is not an emergency landing.</p>
        <h3 class="mt-7 font-semibold text-sm">Recorded transitions</h3>
        <ol class="mt-3 space-y-3 text-xs"><li :for="row in transitions()" class="break-words"><span class="font-mono text-emerald-200">{{ row.nowMs }} ms / {{ row.state }}</span><span class="block mt-1 text-neutral-400">{{ row.reason }}</span></li></ol>
      </div>
    </div>
  </section>
</template>
